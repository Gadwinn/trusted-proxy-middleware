# Ignore files/directories generated by the operating system
.DS_Store
Thumbs.db

# Ignore user-specific configuration files
.idea
.vscode
*.iml

# Ignore dependencies, including "vendor" and "node_modules" directories
vendor/
node_modules/

# Ignore temporary files created by text editors
*~
*.swp
*.swo

# Ignore log files and cache files
error_log
logs/
logs/*
*.log
*.sqlite

# Ignore project-specific environment and configuration files
.env
.env.local
.env.*.local
.env.override
.env.local.php
.env.local.php.dist
.env.php
.env.php.dist

# Ignore PHPStorm configuration files
.idea
*.sublime-*
.sublime-workspace

# Ignore composer backup files and the lock file (a library is not locked)
composer.phar
composer.lock

# Ignore version control history
.history

# Ignore PHPUnit result cache
.phpunit.result.cache

# Ignore PHPStan configuration files
phpstan.neon

# Ignore generated PHPDoc files
.phpdoc/

# Ignore temporary files with .tmp extension
*.tmp

# Generated API documentation (composer gen-docs)
/docs/phpdoc/
